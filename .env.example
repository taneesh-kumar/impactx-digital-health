# ==============================================================================
# SWASTHYASETU DIGITAL HEALTH ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================
# Copy this file to .env.local for local development.
# NEVER commit .env.local or production secrets to source control.

# --- Client-Accessible Public Supabase Config (Safe for browser) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_APP_NAME="SwasthyaSetu - Patient-Controlled Health Records"

# --- Server-Only Secret Credentials (NEVER expose to browser / NEXT_PUBLIC) ---
# Used strictly in server-side route handlers or CLI migration scripts.
# Bypasses RLS only for system maintenance and synthetic data seed workflows.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# --- Optional External OCR Provider (Default uses local deterministic OCR adapter) ---
# Supported providers: tesseract | google_vision | mock
OCR_PROVIDER=mock
OCR_API_KEY=
